{
  "name": "@0xkey-io/turnkey-migrate",
  "version": "0.1.0",
  "description": "CLI tool for migrating wallets and private keys from Turnkey to 0xkey",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "turnkey-migrate": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint src vitest.config.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "release:check": "node scripts/check-public-files.mjs",
    "format:check": "prettier --check src scripts *.json *.mjs *.yaml *.md docs .github",
    "format": "prettier --write src scripts *.json *.mjs *.yaml *.md docs .github"
  },
  "dependencies": {
    "@0xkey-io/crypto": "0.3.0",
    "@0xkey-io/sdk-server": "0.1.4",
    "@turnkey/crypto": "2.9.0",
    "@turnkey/sdk-server": "6.0.0",
    "commander": "12.1.0",
    "yaml": "2.9.0",
    "@0xkey-io/http": "0.1.3",
    "@turnkey/http": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "vitest": "5.0.1",
    "eslint": "10.10.0",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.8"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "private": true
}
